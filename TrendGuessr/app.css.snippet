/* Add this block to the TOP of wwwroot/css/app.css */

@import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600&display=swap');

:root {
    --color-bg: #14181f;
    --color-panel: #1d2330;
    --color-panel-alt: #232a3a;
    --color-parchment: #f2e9d8;
    --color-parchment-ink: #2a2416;
    --color-accent-amber: #e3a23c;
    --color-accent-teal: #4a8b8b;
    --color-text: #edeae1;
    --color-text-muted: #8b93a7;
    --color-border: rgba(237, 234, 225, 0.08);

    --font-display: 'Fraunces', Georgia, serif;
    --font-mono: 'IBM Plex Mono', Consolas, monospace;
    --font-body: 'Inter', system-ui, sans-serif;
}

html, body {
    margin: 0;
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-body);
}
