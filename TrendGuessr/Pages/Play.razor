@page "/play"
@inject NavigationManager Navigation
@inject GameDataService GameData
@inject GameStateService GameState

<PageTitle>TrendGuessr - guess the year</PageTitle>

<section class="page play">
    @if (!string.IsNullOrEmpty(currentImage))
    {
        <div class="play-backdrop" style="background-image:url('@currentImage')" aria-hidden="true"></div>
    }
    <div class="nes-container with-title play-status">
        <p class="title">Status</p>

        <div class="health-row">
            <i class="nes-icon heart is-small" aria-hidden="true"></i>
            <progress class="nes-progress @(health <= 300 ? "is-error" : health <= 600 ? "is-warning" : "is-success")"
                      value="@Math.Max(0, health)"
                      max="1000"
                      aria-label="Health"></progress>
            <span class="health-value @(isSubmitted && lastDamage > 0 ? "hit" : "")">@health</span>
            @if (isSubmitted)
            {
                if (lastDamage == 0)
                {
                    <span class="heal-pop">+@minDamage</span>
                }
                else if (lastDamage > 0) 
                {
                    <span class="damage-pop">-@lastDamage</span>
                }
            }
        </div>

        <div class="stats">
            <div class="stat">
                <span class="stat-label">Multiplier</span>
                <span class="stat-value">@(multiplier)x</span>
            </div>

            <div class="stat">
                <span class="stat-label">Streak</span>
                <span class="stat-value">
                    <i class="nes-icon star is-small" aria-hidden="true"></i>
                    @streak
                </span>
            </div>
        </div>
    </div>

    <div class="nes-container is-rounded play-card">

        <div class="question">
            <p class="question-small">When did</p>
            <p class="question-term">@currentWord</p>
            <p class="question-small">peak in popularity?</p>
        </div>

        <div class="slider-container">
            <span class="selected-year">@selectedYear</span>

            <input class="year-slider"
                   type="range"
                   min=@minYear
                   max=@maxYear
                   value=@selectedYear
                   aria-label="Guess the peak year"
                   @oninput="OnYearChanged" />

            <div class="slider-scale" aria-hidden="true">
                <span>@minYear</span>
                <span>@maxYear</span>
            </div>
        </div>

        <button type="button"
                class="nes-btn @(isSubmitted ? "is-disabled" : "is-primary") submit-btn"
                @onclick="SubmitGuess"
                disabled="@isSubmitted">
            @(isSubmitted ? $"Actual year: {peakYear}" : "Lock in guess")
        </button>

    </div>
</section>


@code {
    // Stats
    private int maxHealth = 1000;
    private int minDamage = 50;
    private int health = 1000;
    private int lastDamage;
    private decimal multiplier = 1;
    private int streak = 0;
    // Trend info
    private string? currentWord;
    private string? currentImage;
    private int peakYear;
    // Year info
    private int minYear = 2005;
    private int maxYear = DateTime.Today.Year;
    private int selectedYear = 2016;
    // Submission
    private bool isSubmitted = false;
    private void OnYearChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var year))
        {
            selectedYear = year;
        }
    }
    private void SubmitGuess()
    {
        if (isSubmitted)
            return;
        isSubmitted = true;
        int distance = Math.Abs(selectedYear - peakYear);
        if (distance == 0)
        {
            lastDamage = 0;
            health += minDamage;
            if (health > maxHealth)
                health = maxHealth;
        }
        else
        {
            lastDamage = (int)Math.Ceiling(distance * minDamage * multiplier);
            health -= lastDamage;
        }
        streak++;
        multiplier += 0.1m;
        _ = AdvanceAfterDelay();
    }
    protected override async Task OnInitializedAsync()
    {
        GameState.ResetGameState();
        await GenerateTrend();
    }
    private async Task AdvanceAfterDelay()
    {
        await Task.Delay(1500);
        if (health <= 0)
        {
            GameState.SetGameState(streak, multiplier, true);
            Navigation.NavigateTo("/results");
            return;
        }
        await GenerateTrend();
        StateHasChanged();
    }
    private async Task GenerateTrend()
    {
        Trend currentTrend = await GameData.GetRandomKeywordAsync();
        currentWord = currentTrend.Keyword;
        currentImage = currentTrend.ImageURL;
        peakYear = currentTrend.PeakYear;
        isSubmitted = false;
    }
}
